{
  "name": "TerMinable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "clean-build": "rm -rf out && next build",
    "export": "touch out/.nojekyll && cp public/CNAME out/CNAME",
    "deploy": "gh-pages --dotfiles -d out",
    "do-the-site": "bun run registry:build && bun run clean-build && bun run export && bun run deploy",
    "check": "eslint . && tsc --noEmit",
    "dev": "next dev --turbo --port 23271",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "registry:build": "shadcn build"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@t3-oss/env-nextjs": "^0.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.3.0",
    "gh-pages": "^6.3.0",
    "lucide-react": "^0.474.0",
    "motion": "^12.4.1",
    "next": "^16.2.6",
    "next-themes": "^0.4.4",
    "react": "19",
    "react-dom": "19",
    "react-intersection-observer": "^9.15.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "4",
    "@types/node": "^20.14.10",
    "@types/react": "19",
    "@types/react-dom": "19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.59.3"
  },
  "ct3aMetadata": {
    "initVersion": "7.38.1"
  }
}
